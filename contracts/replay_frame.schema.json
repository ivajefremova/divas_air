{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "none",
            "monitor",
            "verify_radio",
            "verify_visual",
            "cross_check",
            "act_now",
            "area_gnss_unreliable"
          ],
          "title": "Code",
          "type": "string"
        },
        "text": {
          "description": "action first, plain verbs, every number with a unit",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "code",
        "text"
      ],
      "title": "Action",
      "type": "object"
    },
    "Dimensions": {
      "additionalProperties": false,
      "description": "The four bars of the verdict card, 0 (violated) to 100 (coherent).",
      "properties": {
        "kinetic": {
          "maximum": 100,
          "minimum": 0,
          "title": "Kinetic",
          "type": "number"
        },
        "temporal": {
          "maximum": 100,
          "minimum": 0,
          "title": "Temporal",
          "type": "number"
        },
        "spatial": {
          "maximum": 100,
          "minimum": 0,
          "title": "Spatial",
          "type": "number"
        },
        "contextual": {
          "maximum": 100,
          "minimum": 0,
          "title": "Contextual",
          "type": "number"
        }
      },
      "required": [
        "kinetic",
        "temporal",
        "spatial",
        "contextual"
      ],
      "title": "Dimensions",
      "type": "object"
    },
    "EarlyWarning": {
      "additionalProperties": false,
      "description": "The track, extrapolated at constant velocity, enters a GNSS risk halo.",
      "properties": {
        "risk_zone_id": {
          "title": "Risk Zone Id",
          "type": "string"
        },
        "eta_s": {
          "minimum": 0,
          "title": "Eta S",
          "type": "number"
        }
      },
      "required": [
        "risk_zone_id",
        "eta_s"
      ],
      "title": "EarlyWarning",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "One plain-language sentence, filled from a fixed template with raw values.",
      "properties": {
        "feature": {
          "description": "feature name in contracts/features.csv",
          "title": "Feature",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "kinetic",
            "temporal",
            "spatial",
            "contextual",
            "signal",
            "fleet"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "feature",
        "dimension",
        "text"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "alt_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt M"
        },
        "track_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Deg"
        },
        "speed_mps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed Mps"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Position",
      "type": "object"
    },
    "RiskZoneFeature": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Feature",
          "default": "Feature",
          "title": "Type",
          "type": "string"
        },
        "geometry": {
          "additionalProperties": true,
          "description": "GeoJSON geometry, WGS84 lon/lat. Polygon or MultiPolygon for static and live halos; LineString for a forecast (the extrapolated path of a track about to enter a halo)",
          "title": "Geometry",
          "type": "object"
        },
        "properties": {
          "$ref": "#/$defs/RiskZoneProps"
        }
      },
      "required": [
        "geometry",
        "properties"
      ],
      "title": "RiskZoneFeature",
      "type": "object"
    },
    "RiskZoneProps": {
      "additionalProperties": false,
      "properties": {
        "risk_zone_id": {
          "title": "Risk Zone Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "static",
            "live",
            "forecast"
          ],
          "title": "Kind",
          "type": "string"
        },
        "level": {
          "description": "0 = no risk, 1 = GNSS unusable",
          "maximum": 1,
          "minimum": 0,
          "title": "Level",
          "type": "number"
        },
        "label": {
          "description": "short operator-facing title",
          "title": "Label",
          "type": "string"
        },
        "expected_error_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "static halos",
          "title": "Expected Error M"
        },
        "area_alert_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "live halos",
          "title": "Area Alert Id"
        },
        "track_ids": {
          "description": "live: tracks grouped under this area alert; forecast: the track being extrapolated",
          "items": {
            "type": "string"
          },
          "title": "Track Ids",
          "type": "array"
        },
        "enters_risk_zone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "forecast: the halo the path enters",
          "title": "Enters Risk Zone Id"
        },
        "eta_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "forecast: seconds until the path enters it",
          "title": "Eta S"
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/Action"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "t_start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T Start"
        },
        "t_end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T End"
        }
      },
      "required": [
        "risk_zone_id",
        "kind",
        "level",
        "label"
      ],
      "title": "RiskZoneProps",
      "type": "object"
    },
    "RiskZones": {
      "additionalProperties": false,
      "description": "Body of GET /risk-zones: a GeoJSON FeatureCollection.",
      "properties": {
        "type": {
          "const": "FeatureCollection",
          "default": "FeatureCollection",
          "title": "Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "t": {
          "title": "T",
          "type": "number"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/RiskZoneFeature"
          },
          "title": "Features",
          "type": "array"
        }
      },
      "required": [
        "t",
        "features"
      ],
      "title": "RiskZones",
      "type": "object"
    },
    "Severity": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Level",
          "type": "string"
        },
        "score": {
          "description": "max(untrust, abnormality) x zone criticality",
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "zone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone Id"
        },
        "zone_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone Name"
        },
        "zone_criticality": {
          "maximum": 1,
          "minimum": 0,
          "title": "Zone Criticality",
          "type": "number"
        }
      },
      "required": [
        "level",
        "score",
        "zone_criticality"
      ],
      "title": "Severity",
      "type": "object"
    },
    "Verdict": {
      "additionalProperties": false,
      "description": "One verdict per track per window (30 s window, re-evaluated every 5 s).",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "track_id": {
          "title": "Track Id",
          "type": "string"
        },
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "domain": {
          "enum": [
            "aircraft",
            "vehicle"
          ],
          "title": "Domain",
          "type": "string"
        },
        "asset_class": {
          "title": "Asset Class",
          "type": "string"
        },
        "callsign": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callsign"
        },
        "t": {
          "description": "window end, UNIX seconds UTC",
          "title": "T",
          "type": "number"
        },
        "window_s": {
          "default": 30,
          "title": "Window S",
          "type": "integer"
        },
        "position": {
          "$ref": "#/$defs/Position",
          "description": "last reported fix at or before t"
        },
        "integrity": {
          "description": "is the data sound? smoothed, drives trust_state",
          "maximum": 100,
          "minimum": 0,
          "title": "Integrity",
          "type": "number"
        },
        "integrity_raw": {
          "description": "calibrated, before smoothing",
          "maximum": 100,
          "minimum": 0,
          "title": "Integrity Raw",
          "type": "number"
        },
        "normality": {
          "description": "is the behavior expected?",
          "maximum": 100,
          "minimum": 0,
          "title": "Normality",
          "type": "number"
        },
        "dimensions": {
          "$ref": "#/$defs/Dimensions"
        },
        "trust_state": {
          "enum": [
            "trusted",
            "caution",
            "untrusted"
          ],
          "title": "Trust State",
          "type": "string"
        },
        "normality_state": {
          "enum": [
            "expected",
            "abnormal"
          ],
          "title": "Normality State",
          "type": "string"
        },
        "quadrant": {
          "enum": [
            "trusted",
            "real_event",
            "data_fault",
            "silent_risk"
          ],
          "title": "Quadrant",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "confidence_level": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence Level",
          "type": "string"
        },
        "cause": {
          "description": "reported cause, consistent with trust_state",
          "enum": [
            "plausible",
            "degraded",
            "technical_error",
            "gnss_anomaly",
            "possible_interference",
            "possible_spoofing",
            "behavioral_anomaly"
          ],
          "title": "Cause",
          "type": "string"
        },
        "cause_probs": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "calibrated, all seven causes, sums to 1",
          "propertyNames": {
            "enum": [
              "plausible",
              "degraded",
              "technical_error",
              "gnss_anomaly",
              "possible_interference",
              "possible_spoofing",
              "behavioral_anomaly"
            ]
          },
          "title": "Cause Probs",
          "type": "object"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 3,
          "title": "Evidence",
          "type": "array"
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "area_alert_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set when the track belongs to an area alert",
          "title": "Area Alert Id"
        },
        "early_warning": {
          "anyOf": [
            {
              "$ref": "#/$defs/EarlyWarning"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "track_id",
        "asset_id",
        "domain",
        "asset_class",
        "t",
        "position",
        "integrity",
        "integrity_raw",
        "normality",
        "dimensions",
        "trust_state",
        "normality_state",
        "quadrant",
        "confidence",
        "confidence_level",
        "cause",
        "cause_probs",
        "severity",
        "evidence",
        "action"
      ],
      "title": "Verdict",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One line of frames.jsonl: the full API state at engine time t.",
  "properties": {
    "t": {
      "title": "T",
      "type": "number"
    },
    "verdicts": {
      "items": {
        "$ref": "#/$defs/Verdict"
      },
      "title": "Verdicts",
      "type": "array"
    },
    "risk_zones": {
      "$ref": "#/$defs/RiskZones"
    }
  },
  "required": [
    "t",
    "verdicts",
    "risk_zones"
  ],
  "title": "ReplayFrame",
  "type": "object"
}
